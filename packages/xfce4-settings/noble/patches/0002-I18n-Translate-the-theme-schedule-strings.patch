+msgstr "სიკაშკაშე %s%%"
+
+msgid "Dark"
+msgstr "მუქი"
+
+msgid "Light"
+msgstr "ღია"
+
+msgid "Change the style automatica_lly at set times"
+msgstr "სტილის _ავტომატური გადართვა დანიშნულ დროს"
+
