+
+msgid "Dark"
+msgstr "قېنىق"
+
+msgid "Light"
+msgstr "ئاچ"
+
+msgid "Change the style automatica_lly at set times"
+msgstr "ئۇسلۇبنى بەلگىلەنگەن ۋاقىتلاردا ئاپتوماتىك ئالماشتۇر(_L)"
+
+msgid "Theme"
