 msgid "settings;daemon;xfce;configuration;preferences;system;manage;"
 msgstr ""
+
+msgid "no dark variant of %s"
+msgstr "የ%s ጨለማ ዓይነት የለም"
+
+msgid "no light variant of %s"
+msgstr "የ%s ብሩህ ዓይነት የለም"
+
+msgid "dark color scheme"
+msgstr "ጨለማ የቀለም ገጽታ"
+
+msgid "light color scheme"
+msgstr "ብሩህ የቀለም ገጽታ"
+
+msgid "default color scheme"
+msgstr "ነባሪ የቀለም ገጽታ"
+
+msgid "%d more action"
+msgid_plural "%d more actions"
+msgstr[0] "ተጨማሪ %d ተግባር"
+msgstr[1] "ተጨማሪ %d ተግባሮች"
+
+msgid "no change"
+msgstr "ለውጥ የለም"
+
+msgid "Add a rule to switch the style at a given time."
+msgstr "ዘይቤውን በተወሰነ ሰዓት ለመቀየር ደንብ ይጨምሩ።"
+
+msgid "Next switch at %02d:%02d: %s"
+msgstr "የሚቀጥለው ቅየራ በ%02d:%02d: %s"
+
+#, c-format
+msgid "There is already a rule at %s."
+msgstr "በ%s ደንብ አስቀድሞ አለ።"
+
+msgid "Sunrise"
+msgstr "የፀሐይ መውጫ"
+
+msgid "Sunset"
+msgstr "የፀሐይ መጥለቂያ"
+
+#, c-format
+msgid "Sunrise %+d min"
+msgstr "የፀሐይ መውጫ %+d ደቂቃ"
+
+#, c-format
+msgid "Sunset %+d min"
+msgstr "የፀሐይ መጥለቂያ %+d ደቂቃ"
+
+msgid "Choose a location for sunrise and sunset."
+msgstr "ለፀሐይ መውጫ እና መጥለቂያ ቦታ ይምረጡ።"
+
+#, c-format
+msgid "%s: no sunrise or sunset today"
+msgstr "%s: ዛሬ የፀሐይ መውጫ ወይም መጥለቂያ የለም"
+
+#, c-format
+msgid "%s: sunrise %02d:%02d, sunset %02d:%02d"
+msgstr "%s: የፀሐይ መውጫ %02d:%02d፣ መጥለቂያ %02d:%02d"
+
+msgid "At a time"
+msgstr "በሰዓት"
+
+msgid "At sunrise"
+msgstr "በፀሐይ መውጫ"
+
+msgid "At sunset"
+msgstr "በፀሐይ መጥለቂያ"
+
+msgid "Minutes before (-) or after (+)"
+msgstr "ከዚያ በፊት (-) ወይም በኋላ (+) ያሉ ደቂቃዎች"
+
+msgid "min"
+msgstr "ደቂቃ"
+
+msgid "Location for Sunrise and Sunset"
+msgstr "የፀሐይ መውጫ እና መጥለቂያ ቦታ"
+
+#, c-format
+msgid "Use the location of the _time zone (%s)"
+msgstr "የ_ሰዓት ክልሉን ቦታ ተጠቀም (%s)"
+
+msgid "Use the location of the _time zone (unknown)"
+msgstr "የ_ሰዓት ክልሉን ቦታ ተጠቀም (ያልታወቀ)"
+
+msgid "C_ity:"
+msgstr "_ከተማ:"
+
+msgid "The main city of a time zone, type a part of its name"
+msgstr "የሰዓት ክልል ዋና ከተማ፣ የስሙን ክፍል ይጻፉ"
+
+msgid "Coo_rdinates:"
+msgstr "_መጋጠሚያዎች:"
+
+msgid "L_atitude:"
+msgstr "_ኬክሮስ:"
+
+msgid "Degrees, negative for south"
+msgstr "ዲግሪዎች፣ ለደቡብ አሉታዊ"
+
+msgid "L_ongitude:"
+msgstr "ኬን_ትሮስ:"
+
+msgid "Degrees, negative for west"
+msgstr "ዲግሪዎች፣ ለምዕራብ አሉታዊ"
+
+msgid "Time: a time of the day, or sunrise or sunset, also some minutes before or after. Sunrise and sunset are computed for the location of the time zone, or for a location of your choice."
+msgstr "ሰዓት: የቀኑ ሰዓት፣ ወይም የፀሐይ መውጫ ወይም መጥለቂያ፣ ከጥቂት ደቂቃዎች በፊት ወይም በኋላም። የፀሐይ መውጫ እና መጥለቂያ ለሰዓት ክልሉ ቦታ ወይም ለመረጡት ቦታ ይሰላሉ።"
+
+msgid "_Location…"
+msgstr "_ቦታ…"
+
+msgid "Dark variant"
+msgstr "ጨለማ ዓይነት"
+
+msgid "Light variant"
+msgstr "ብሩህ ዓይነት"
+
+msgid "No change"
+msgstr "ለውጥ የለም"
+
+msgid "Rule at %s"
+msgstr "ደንብ በ%s"
+
+msgid "Set the matching _window manager theme along with the theme"
+msgstr "ከገጽታው ጋር ተዛማጅ የ_መስኮት አስተዳዳሪ ገጽታ ማሰናጃ"
+
+msgid "Set the _icon theme:"
+msgstr "የ_ምልክት ገጽታ ማሰናጃ:"
+
+msgid "Set the mouse _cursor theme:"
+msgstr "የአይጥ _መጠቆሚያ ገጽታ ማሰናጃ:"
+
+msgid "Run co_mmand:"
+msgstr "_ትእዛዝ ማስኬጃ:"
+
+msgid "The command runs with /bin/sh after switching. The new settings are in $XFCE_SCHEDULE_GTK_THEME, $XFCE_SCHEDULE_ICON_THEME and $XFCE_SCHEDULE_COLOR_SCHEME."
+msgstr "ትእዛዙ ከቅየራው በኋላ በ/bin/sh ይሄዳል። አዲሶቹ ማሰናጃዎች በ$XFCE_SCHEDULE_GTK_THEME, $XFCE_SCHEDULE_ICON_THEME እና $XFCE_SCHEDULE_COLOR_SCHEME ውስጥ ናቸው።"
+
+msgid "icons"
+msgstr "ምልክቶች"
+
+msgid "cursor"
+msgstr "መጠቆሚያ"
+
+msgid "command"
+msgstr "ትእዛዝ"
+
+msgid "Switching the style at set times"
+msgstr "ዘይቤን በተወሰኑ ሰዓቶች መቀየር"
+
+msgid "Each rule takes effect when the clock reaches its time; the settings stay until the next rule. A setting changed by hand stays until the next rule as well. A switch missed while you were logged out is made at login."
+msgstr "እያንዳንዱ ደንብ ሰዓቱ ጊዜው ላይ ሲደርስ ተግባራዊ ይሆናል፤ ማሰናጃዎቹ እስከሚቀጥለው ደንብ ይቆያሉ። በእጅ የተቀየረ ማሰናጃም እስከሚቀጥለው ደንብ ይቆያል። ወጥተው በነበረበት ጊዜ ያመለጠ ቅየራ ሲገቡ ይፈጸማል።"
+
+msgid "Theme: \"Dark variant\" and \"Light variant\" are looked up from the theme in use at the time of the switch, e.g. Greybird becomes Greybird-dark, Orchis-Compact becomes Orchis-Dark-Compact. Upper and lower case do not matter. If there is no such variant, the theme stays. The theme is used by Xfce and GTK 3 applications."
+msgstr "ገጽታ: «ጨለማ ዓይነት» እና «ብሩህ ዓይነት» በቅየራው ጊዜ በጥቅም ላይ ካለው ገጽታ ይፈለጋሉ፤ ለምሳሌ Greybird Greybird-dark ይሆናል፣ Orchis-Compact Orchis-Dark-Compact ይሆናል። ትልቅና ትንሽ ፊደል ልዩነት የለውም። እንዲህ ያለ ዓይነት ከሌለ ገጽታው ይቆያል። ገጽታው በXfce እና በGTK 3 መተግበሪያዎች ይጠቀማል።"
+
+msgid "Color scheme: the dark or light preference of the desktop, read by GTK 4 and libadwaita, Qt 6, Firefox, Chromium and Electron applications. Firefox follows it if Website appearance is set to Automatic, Chromium if Mode is set to Device."
+msgstr "የቀለም ገጽታ: የዴስክቶፑ የጨለማ ወይም የብሩህ ምርጫ፣ በGTK 4 እና libadwaita፣ Qt 6፣ Firefox፣ Chromium እና Electron መተግበሪያዎች ይነበባል። Firefox «የድር ጣቢያ ገጽታ» «ራስ-ሰር» ከሆነ፣ Chromium «ሁነታ» «መሣሪያ» ከሆነ ይከተሉታል።"
+
+msgid "More: also set the window manager theme, the icon theme, the mouse cursor theme or the brightness of a laptop screen, or run a command of your own."
+msgstr "ተጨማሪ: የመስኮት አስተዳዳሪ ገጽታን፣ የምልክት ገጽታን፣ የአይጥ መጠቆሚያ ገጽታን ወይም የላፕቶፕ ማያ ብሩህነትን ደግሞ ማሰናጃ፣ ወይም የራስዎን ትእዛዝ ማስኬጃ።"
+
+msgid "Set the screen _brightness to:"
+msgstr "የማያ _ብሩህነት ማሰናጃ ወደ:"
+
+msgid "No screen backlight was found."
+msgstr "የማያ የጀርባ ብርሃን አልተገኘም።"
+
+#, c-format
+msgid "brightness %s%%"
+msgstr "ብሩህነት %s%%"
+
+msgid "Dark"
+msgstr "ጨለማ"
+
+msgid "Light"
+msgstr "ብሩህ"
+
+msgid "Change the style automatica_lly at set times"
+msgstr "ዘይቤን በተወሰኑ ሰዓቶች _በራስ-ሰር መቀየሪያ"
+
+msgid "Theme"
+msgstr "ገጽታ"
+
+msgid "Color scheme"
+msgstr "የቀለም ገጽታ"
+
+msgid "More"
+msgstr "ተጨማሪ"
+
+msgid "_More…"
+msgstr "_ተጨማሪ…"
+
+msgid "The theme is used by Xfce and GTK 3 applications. The color scheme is followed by GTK 4 and Qt 6 applications, Firefox, Chromium and other web browsers."
+msgstr "ገጽታው በXfce እና በGTK 3 መተግበሪያዎች ይጠቀማል። የቀለም ገጽታውን የGTK 4 እና Qt 6 መተግበሪያዎች፣ Firefox፣ Chromium እና ሌሎች የድር መቃኛዎች ይከተሉታል።"
+
+msgid "_Schedule"
+msgstr "_መርሐ ግብር"
+
+msgid "Time"
+msgstr "ሰዓት"
